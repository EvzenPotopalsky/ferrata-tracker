rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ferratas/{ferrataId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId}/completedFerratas/{ferrataId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function hasValidCompletionData() {
        return request.resource.data.keys().hasAll(['completedAt', 'note'])
          && request.resource.data.keys().hasOnly(['completedAt', 'note'])
          && request.resource.data.completedAt is string
          && request.resource.data.completedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 2000;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasValidCompletionData()
        && exists(/databases/$(database)/documents/ferratas/$(ferrataId));
    }
  }
}
